   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"build", " ", "list", " ", "of", " ", "points"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lineX1s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 
        RowBox[{"getAttribute", "[", 
         RowBox[{"#", ",", "\"\<x1\>\""}], "]"}], "]"}], "&"}], "/@", 
      "lines"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lineY1s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 

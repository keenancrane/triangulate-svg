Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Write", " ", "mesh", " ", "and", " ", "curves", " ", "to", " ", "OBJ"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{

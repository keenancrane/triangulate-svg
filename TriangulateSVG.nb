      "lines"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linePoints1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Flatten", "/@", 
        RowBox[{"{", 
         RowBox[{"lineX1s", ",", "lineY1s"}], "}"}]}], ")"}], 

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"some", " ", "helper", " ", "functions"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getAttribute", "[", 
      RowBox[{"tag_", ",", "attribute_"}], "]"}], ":=", 
     RowBox[{"attribute", "/.", 
      RowBox[{
      "tag", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"parsePoints", "[", "s_", "]"}], ":=", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringSplit", "[", 
       RowBox[{
        RowBox[{"StringSplit", "[", 
         RowBox[{"s", ",", "Whitespace"}], "]"}], ",", "\"\<,\>\""}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ListAccumulate", "[", "l_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "n", ",", "a"}], "}"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{
         "l", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Max", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "2"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{"Length", "[", "l", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"a", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"a", ",", 
              RowBox[{"n", "+", 
               RowBox[{
               "l", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"n", "+=", 
            RowBox[{"Max", "[", 
             RowBox[{
             "l", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "a", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RemoveTrailingDuplicates", "[", "list_", "]"}], ":=", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Last", "[", "list", "]"}], "===", 
        RowBox[{"First", "[", "list", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Most", "[", 
         RowBox[{"Split", "[", 
          RowBox[{"list", ",", 
           RowBox[{
            RowBox[{"#1", "==", "#2"}], "&"}]}], "]"}], "]"}], "//", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&"}]}], ",", "\[IndentingNewLine]",
        "list"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"extract", " ", "lines"}], ",", " ", 

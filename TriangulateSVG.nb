         RowBox[{"T0", ",", " ", "points"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"TriangleSetSegments", "[", 
         RowBox[{"T0", ",", "segments"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"T", "=", 
         RowBox[{"TriangleTriangulate", "[", 
          RowBox[{"T0", ",", 
           RowBox[{"\"\<pqa\>\"", "<>", 

           "\[IndentingNewLine]", 
           RowBox[{"TriangleGetSegments", "[", "T", "]"}]}], 
          "\[IndentingNewLine]", "}"}], "]"}], ";"}]}], "\[IndentingNewLine]",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"some", " ", "helper", " ", "functions"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getAttribute", "[", 
      RowBox[{"tag_", ",", "attribute_"}], "]"}], ":=", 
     RowBox[{"attribute", "/.", 
      RowBox[{
      "tag", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"parsePoints", "[", "s_", "]"}], ":=", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"StringSplit", "[", 
       RowBox[{
        RowBox[{"StringSplit", "[", 
         RowBox[{"s", ",", "Whitespace"}], "]"}], ",", "\"\<,\>\""}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ListAccumulate", "[", "l_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "n", ",", "a"}], "}"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{
         "l", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Max", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "2"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{"Length", "[", "l", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"a", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"a", ",", 
              RowBox[{"n", "+", 
               RowBox[{
               "l", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"n", "+=", 
            RowBox[{"Max", "[", 
             RowBox[{
             "l", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "a", "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RemoveTrailingDuplicates", "[", "list_", "]"}], ":=", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Last", "[", "list", "]"}], "===", 
        RowBox[{"First", "[", "list", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Most", "[", 
         RowBox[{"Split", "[", 
          RowBox[{"list", ",", 
           RowBox[{
            RowBox[{"#1", "==", "#2"}], "&"}]}], "]"}], "]"}], "//", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&"}]}], ",", "\[IndentingNewLine]",
        "list"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"extract", " ", "lines"}], ",", " ", 
     RowBox[{"polygons", " ", "and", " ", "polylines"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lines", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"svg", ",", 
       RowBox[{"XMLElement", "[", 
        RowBox[{"\"\<line\>\"", ",", "_", ",", "_"}], "]"}], ",", 
       "Infinity"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polylines", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"svg", ",", 
       RowBox[{"XMLElement", "[", 
        RowBox[{"\"\<polyline\>\"", ",", "_", ",", "_"}], "]"}], ",", 
       "Infinity"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polygons", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{"svg", ",", 
       RowBox[{"XMLElement", "[", 
        RowBox[{"\"\<polygon\>\"", ",", "_", ",", "_"}], "]"}], ",", 
       "Infinity"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"build", " ", "list", " ", "of", " ", "points"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lineX1s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 
        RowBox[{"getAttribute", "[", 
         RowBox[{"#", ",", "\"\<x1\>\""}], "]"}], "]"}], "&"}], "/@", 
      "lines"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lineY1s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 
        RowBox[{"getAttribute", "[", 
         RowBox[{"#", ",", "\"\<y1\>\""}], "]"}], "]"}], "&"}], "/@", 
      "lines"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lineX2s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 
        RowBox[{"getAttribute", "[", 
         RowBox[{"#", ",", "\"\<x2\>\""}], "]"}], "]"}], "&"}], "/@", 
      "lines"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lineY2s", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 
        RowBox[{"getAttribute", "[", 
         RowBox[{"#", ",", "\"\<y2\>\""}], "]"}], "]"}], "&"}], "/@", 
      "lines"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linePoints1", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Flatten", "/@", 
        RowBox[{"{", 
         RowBox[{"lineX1s", ",", "lineY1s"}], "}"}]}], ")"}], 
      "\[Transpose]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linePoints2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Flatten", "/@", 
        RowBox[{"{", 
         RowBox[{"lineX2s", ",", "lineY2s"}], "}"}]}], ")"}], 
      "\[Transpose]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polylinePoints", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 
        RowBox[{"getAttribute", "[", 
         RowBox[{"#", ",", "\"\<points\>\""}], "]"}], "]"}], "&"}], "/@", 
      "polylines"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polygonPoints", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"parsePoints", "[", 
        RowBox[{"getAttribute", "[", 
         RowBox[{"#", ",", "\"\<points\>\""}], "]"}], "]"}], "&"}], "/@", 
      "polygons"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polygonPoints", "=", 
     RowBox[{"Flatten", "/@", "polygonPoints"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "turn", " ", "each", " ", "polygon", " ", "into", " ", "a", " ", "flat", 
      " ", "list", " ", "of", " ", "coordinates"}], ",", " ", 
     RowBox[{"since", " ", "different", " ", "SVG", " ", "formats", " ", 
      RowBox[{"(", 

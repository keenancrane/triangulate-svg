Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Write", " ", "mesh", " ", "and", " ", "curves", " ", "to", " ", "OBJ"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"out", "=", 
     RowBox[{"OpenWrite", "[", "\"\<out.obj\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Write", " ", "vertices"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", 
     RowBox[{"i", "\[LessEqual]", 
      RowBox[{"Length", "[", "vertices", "]"}]}], ",", 
     RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WriteString", "[", 
       RowBox[{"out", ",", "\"\<v\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"vi", "=", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{
         "vertices", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ",",
          "0"}], "]"}]}], ";", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"place", " ", "in", " ", "XY", " ", "plane", " ", 
        RowBox[{"(", 
         RowBox[{"Z", "=", "0"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"p", "=", "1"}], ",", 
        RowBox[{"p", "\[LessEqual]", "3"}], ",", 
        RowBox[{"p", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"WriteString", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\< \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"CForm", "[", 
              RowBox[{
              "vi", "\[LeftDoubleBracket]", "p", "\[RightDoubleBracket]"}], 
              "]"}], "]"}]}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"WriteString", "[", 
       RowBox[{"out", ",", "\"\<\\n\>\""}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Write", " ", "triangles"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "\[LessEqual]", 
       RowBox[{"Length", "[", "triangles", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"WriteString", "[", 
        RowBox[{"out", ",", "\"\<f\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"p", "=", "1"}], ",", 
         RowBox[{"p", "\[LessEqual]", "3"}], ",", 
         RowBox[{"p", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"out", ",", 
            RowBox[{"\"\< \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"triangles", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "p"}], "\[RightDoubleBracket]"}], "]"}]}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"out", ",", "\"\<\\n\>\""}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Write", " ", "segments"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "\[LessEqual]", 
       RowBox[{"Length", "[", "edges", "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"WriteString", "[", 
        RowBox[{"out", ",", "\"\<l\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"p", "=", "1"}], ",", 
         RowBox[{"p", "\[LessEqual]", "2"}], ",", 
         RowBox[{"p", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"WriteString", "[", 
           RowBox[{"out", ",", 
            RowBox[{"\"\< \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"edges", "\[LeftDoubleBracket]", 
               RowBox[{"i", ",", "p"}], "\[RightDoubleBracket]"}], "]"}]}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"WriteString", "[", 
        RowBox[{"out", ",", "\"\<\\n\>\""}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Close", "[", "out", "]"}], ";"}]}]}]], "Input",

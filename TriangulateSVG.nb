Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Constrained", " ", "Delaunay", " ", "triangulation", " ", "with", " ", 
    "sizing", " ", "h"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Triangulate", "[", 
      RowBox[{"points_", ",", "segments_", ",", "h_"}], "]"}], ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"T0", ",", "T"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"T0", "=", 
         RowBox[{"TriangleCreate", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"TriangleSetPoints", "[", 
         RowBox[{"T0", ",", " ", "points"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"TriangleSetSegments", "[", 
         RowBox[{"T0", ",", "segments"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"T", "=", 
         RowBox[{"TriangleTriangulate", "[", 
          RowBox[{"T0", ",", 
           RowBox[{"\"\<pqa\>\"", "<>", 
            RowBox[{"ToString", "[", "h", "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"TriangleGetPoints", "[", "T", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"TriangleGetElements", "[", "T", "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"TriangleGetSegments", "[", "T", "]"}]}], 
          "\[IndentingNewLine]", "}"}], "]"}], ";"}]}], "\[IndentingNewLine]",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "triangulate", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vertices", ",", "triangles", ",", "edges"}], "}"}], "=", 
     RowBox[{"Triangulate", "[", 
      RowBox[{"points", ",", "segments", ",", "maxEdgeLength"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"show", " ", "output", " ", "triangulation"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Graphics", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FaceForm", "[", "]"}], ",", 
      RowBox[{"EdgeForm", "[", "LightGray", "]"}], ",", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{"vertices", ",", 
        RowBox[{"Polygon", "/@", "triangles"}]}], "]"}], ",", "Thick", ",", 
      "Black", ",", 
      RowBox[{"GraphicsComplex", "[", 
       RowBox[{"vertices", ",", 
        RowBox[{"Line", "/@", "edges"}]}], "]"}]}], "}"}], "]"}]}]}]], "Input",\


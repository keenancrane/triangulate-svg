   RowBox[{
    RowBox[{"points", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"points", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nPoints", "/", "2"}], ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 

       "will", " ", "result", " ", "in", " ", "different", " ", "array", " ", 
      "structures"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polygonPoints", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], "/", "2"}], ",", "2"}], 
          "}"}]}], "]"}], "&"}], "/@", "polygonPoints"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "turn", " ", "point", " ", "list", " ", "back", " ", "into", " ", "pairs",
      " ", "of", " ", "coordinates"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polygonPoints", "=", 
     RowBox[{"RemoveTrailingDuplicates", "/@", "polygonPoints"}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"eliminate", " ", "redundant", " ", "points", " ", "at", " ", 
      RowBox[{"start", "/", "end"}], " ", "of", " ", "polygons"}], ",", " ", 
     RowBox[{
     "which", " ", "some", " ", "programs", " ", "erroneously", " ", 
      "write"}]}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   
   RowBox[{"(*", " ", 
    RowBox[{
    "put", " ", "point", " ", "coordinates", " ", "from", " ", "all", " ", 
     "elements", " ", "in", " ", "a", " ", "single", " ", "list"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"points", "=", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{
       RowBox[{"Join", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Riffle", "[", 
          RowBox[{"linePoints1", ",", "linePoints2"}], "]"}], ",", 
         "\[IndentingNewLine]", "polylinePoints", ",", "\[IndentingNewLine]", 
         "polygonPoints"}], "\[IndentingNewLine]", "]"}], ",", "1"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nPoints", "=", 
     RowBox[{"Length", "[", 
      RowBox[{"Flatten", "[", "points", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"points", "=", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"points", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"nPoints", "/", "2"}], ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
